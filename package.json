{
  "name": "dsh-plugins",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "Out-of-tree DSH plugin workspace",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "check": "pnpm run typecheck && pnpm run build",
    "pack:all": "pnpm -r exec npm pack --pack-destination ../../dist"
  }
}
