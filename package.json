{
  "name": "dsh-plugins",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Out-of-tree DSH plugin workspace",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "check": "pnpm run typecheck && pnpm run build",
    "pack:all": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && pnpm -r exec npm pack --pack-destination ../../dist",
    "desktop:embed": "node scripts/build-desktop-with-plugin.mjs",
    "desktop:embed:dry": "node scripts/build-desktop-with-plugin.mjs --dry-run",
    "desktop:embed:dir": "node scripts/build-desktop-with-plugin.mjs --script package:desktop:win:x64:dir"
  }
}
