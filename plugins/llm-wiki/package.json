{
  "name": "@dsh-plugins-xz/llm-wiki",
  "version": "0.1.7",
  "description": "Karpathy-style three-layer knowledge base for DSH: immutable raw sources, an LLM-maintained wiki, and a schema that tells the LLM how to maintain that wiki.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tessdata",
    "models",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node ../../packages/plugin-kit/build-plugin.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "fetch-models": "node scripts/fetch-models.mjs && node scripts/fetch-embed-model.mjs",
    "fetch-embed-model": "node scripts/fetch-embed-model.mjs",
    "prepack": "node scripts/fetch-models.mjs && node scripts/fetch-embed-model.mjs && node ../../packages/plugin-kit/prepack.mjs",
    "postpack": "node ../../packages/plugin-kit/postpack.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-rc.1"
  },
  "devDependencies": {
    "@dsh-plugins-xz/log-utils": "workspace:*",
    "@dsh-plugins-xz/plugin-kit": "workspace:*",
    "@dsh-plugins-xz/result-utils": "workspace:*",
    "@dsh-plugins-xz/time-utils": "workspace:*",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "chokidar": "^4.0.0",
    "iconv-lite": "^0.6.3",
    "jschardet-ultra": "^2.1.0",
    "mammoth": "^1.8.0",
    "onnxruntime-node": "^1.30.0",
    "pdfjs-dist": "^6.3.0",
    "tesseract.js": "^5.1.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}