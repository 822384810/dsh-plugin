{
  "name": "@dsh-plugins-xz/session-persona-manager",
  "version": "0.1.5",
  "description": "Session-scoped persona management for DSH: bind a persona per session and inject it into the system prompt.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node ../../packages/plugin-kit/build-plugin.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node ../../packages/plugin-kit/prepack.mjs",
    "postpack": "node ../../packages/plugin-kit/postpack.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-home-paths": ">=0.1.5-rc.2"
  },
  "devDependencies": {
    "@dsh-plugins-xz/plugin-kit": "workspace:*",
    "@dsh-plugins-xz/result-utils": "workspace:*",
    "@dsh-plugins-xz/time-utils": "workspace:*",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}