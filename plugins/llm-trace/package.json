{
  "name": "@dsh-plugins-xz/llm-trace",
  "version": "0.1.5",
  "description": "Dump every model request the agent loop dispatches (assembled system prompt + exact message list) as readable JSON.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node ../../packages/plugin-kit/build-plugin.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node ../../packages/plugin-kit/prepack.mjs",
    "postpack": "node ../../packages/plugin-kit/postpack.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-home-paths": ">=0.1.6-alpha.1"
  },
  "devDependencies": {
    "@dsh-plugins-xz/plugin-kit": "workspace:*",
    "@types/node": "^22.20.0",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.3"
  }
}